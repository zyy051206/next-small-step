{
  "name": "next-small-step-desktop",
  "version": "2.1.0",
  "private": true,
  "description": "下一小步：离线目标、日历待办与番茄专注桌面应用",
  "author": "zyy051206",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "make-icon": "electron make-icon.cjs",
    "build:win": "npm run make-icon && electron-builder --win nsis --x64 --publish never",
    "smoke": "node smoke.cjs",
    "test": "node --test updates.test.cjs reminders.test.cjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.zyy051206.nextstep.desktop",
    "productName": "下一小步",
    "copyright": "Copyright © 2026 zyy051206",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "reminders.cjs",
      "updates.cjs",
      "update-smoke.cjs",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "executableName": "NextSmallStep"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "next-small-step-${version}-windows-${arch}.exe"
    },
    "publish": [{ "provider": "github", "owner": "zyy051206", "repo": "next-small-step", "releaseType": "release" }]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
